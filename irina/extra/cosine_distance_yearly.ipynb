    "for country in country_list:\n",
    "    fig.add_scatter(\n",
    "        x=df_dist_yearly_flat.query(\"country == @country\").groupby(\"year\", as_index=False).dist.mean().year,\n",
    "        y=df_dist_yearly_flat.query(\"country == @country\").groupby(\"year\", as_index=False).dist.mean().dist,\n",
    "        mode=\"lines\",\n",
    "        name=country,\n",
    "        # line=dict(width=3)\n",
    "    )\n",
    "fig.show()\n",
